---
import PostViews from '../../components/PostViews.astro';
import BaseLayout from '../../layouts/PortfolioLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.language === 'en');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const readingMinutes = Math.ceil(post.body.split(/\s+/).length / 220);
const contents = headings.filter(({ depth }) => depth === 2);
---

<BaseLayout title={`${post.data.title} — Adrián Hernández Padrón`} description={post.data.description}>
  <main class="post-layout">
    <a class="post-back" href="/blog">← All writing</a>
    <article>
      <header class="post-header">
        <div class="post-tags">{post.data.tags.map((tag) => <a href={`/tags/${tag}`}>{tag}</a>)}</div>
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
        <div class="post-meta">
          <span>{post.data.author}</span>
          <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
          <span>{readingMinutes} min read</span>
          <PostViews slug={post.slug} record />
        </div>
        {post.data.originalUrl && <p class="post-source">Originally published on <a href={post.data.originalUrl}>Medium</a>. Original text; diagrams redrawn for this edition.</p>}
      </header>
      <div class="post-grid">
        <aside class="post-toc">
          <details open>
            <summary>In this article</summary>
            <nav aria-label="Table of contents"><ol>{contents.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}</ol></nav>
          </details>
        </aside>
        <div class="post-content prose prose-lg max-w-none" id="post-content">
          <Content />
        </div>
      </div>
      <footer class="post-footer"><a href="/blog">← Back to all writing</a></footer>
    </article>
  </main>
  <dialog class="figure-dialog" aria-label="Enlarged article figure">
    <button class="figure-close" type="button" autofocus>Close figure ×</button>
    <img alt="" />
  </dialog>
</BaseLayout>

<script>
  const article = document.querySelector<HTMLElement>('.post-content');
  const dialog = document.querySelector<HTMLDialogElement>('.figure-dialog');
  if (article && dialog) {
    article.querySelectorAll('img').forEach((image) => {
      image.loading = 'lazy';
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'figure-expand';
      button.setAttribute('aria-label', `Enlarge figure: ${image.alt}`);
      image.replaceWith(button);
      button.append(image);
      const hint = document.createElement('span');
      hint.textContent = 'Enlarge figure ↗';
      button.append(hint);
      button.addEventListener('click', () => {
        const large = dialog.querySelector('img')!;
        large.src = image.src;
        large.alt = image.alt;
        dialog.showModal();
      });
    });
    article.querySelectorAll('table').forEach((table, i) => {
      const region = document.createElement('div');
      region.className = 'table-scroll';
      region.tabIndex = 0;
      region.setAttribute('role', 'region');
      region.setAttribute('aria-label', `Table ${i + 1}: scroll horizontally for all columns`);
      table.replaceWith(region);
      region.append(table);
    });
    dialog.querySelector('button')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  }
</script>

<style is:global>
  .post-layout{max-width:1240px;width:100%;margin:auto;padding:36px 6% 70px;min-width:0;color:#2f3437}
  .post-back,.post-footer a{color:#365b47;font-size:14px;text-decoration:none}
  .post-header{max-width:890px;margin:52px 0 55px}
  .post-tags{display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:#365b47}
  .post-tags a{text-decoration:none}.post-header h1{font-size:clamp(36px,4.8vw,62px);line-height:1.09;letter-spacing:-.035em;margin:24px 0;color:#2f3437;text-wrap:balance}
  .post-description{font-size:18px;line-height:1.7;max-width:66ch;color:#505e55}
  .post-meta{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:25px;font-size:12px;color:#505e55}
  .post-source{font-size:12px;line-height:1.7;margin-top:20px;color:#505e55}.post-source a{color:#365b47}
  .post-grid{display:grid;grid-template-columns:210px minmax(0,1fr);gap:55px;align-items:start;border-top:1px solid #bbc7bb;padding-top:42px}
  .post-toc{position:sticky;top:30px;font-size:12px;line-height:1.6}.post-toc summary{font-size:14px;font-weight:600;margin-bottom:18px;cursor:pointer}.post-toc ol{list-style:none;padding:0;margin:0}.post-toc li{margin-bottom:12px}.post-toc a{color:#505e55;text-decoration:none}.post-toc a:hover{color:#365b47;text-decoration:underline}
  .post-content{min-width:0;font-size:16px;line-height:1.9;--tw-prose-links:#365b47;--tw-prose-code:#365b47;--tw-prose-counters:#505e55;--tw-prose-bullets:#365b47}
  .post-content>:first-child{margin-top:0}.post-content h2{font-size:28px;line-height:1.25;letter-spacing:-.025em;margin-top:52px;scroll-margin-top:30px}.post-content h3{font-size:23px}.post-content p{max-width:72ch}.post-content a{overflow-wrap:anywhere}.post-content pre{font-size:12px;max-width:100%;overflow:auto;line-height:1.8;padding:22px;border:1px solid #bbc7bb;border-radius:5px}.post-content code{overflow-wrap:anywhere}.post-content pre code{overflow-wrap:normal}.post-content img{display:block;width:100%;height:auto;border-radius:4px;margin:0}.post-content p:has(>em:only-child){font-size:13px;line-height:1.75;color:#505e55}
  .post-content table{display:block;max-width:100%;overflow-x:auto;font-size:12px;line-height:1.6}.post-content th{color:#2f3437;background:#e3e8df;font-weight:600;text-align:left}.post-content th,.post-content td{padding:12px 14px;min-width:120px;border-bottom:1px solid #bbc7bb}.post-content th:first-child,.post-content td:first-child{min-width:180px}.table-scroll{max-width:100%;overflow-x:auto;margin:28px 0}.table-scroll table{display:table;margin:0;min-width:100%}
  .figure-expand{display:block;width:100%;padding:0;background:transparent;border:0;text-align:right;cursor:zoom-in;margin:32px 0 12px;color:#365b47}.figure-expand span{display:inline-block;font-size:12px;margin-top:9px}.figure-expand:hover span{text-decoration:underline}.figure-expand:focus-visible,.table-scroll:focus-visible{outline:2px solid #365b47;outline-offset:4px}
  .figure-dialog{width:min(1500px,96vw);max-width:96vw;max-height:94dvh;padding:20px;border:1px solid #bbc7bb;background:#f3f1ec;color:#2f3437;border-radius:6px;overflow:auto}.figure-dialog::backdrop{background:#14251cbd}.figure-dialog img{display:block;width:100%;height:auto;margin-top:18px}.figure-close{display:block;margin-left:auto;background:none;border:1px solid #bbc7bb;padding:8px 13px;cursor:pointer;border-radius:3px}.post-footer{margin-top:60px;padding-top:28px;border-top:1px solid #bbc7bb}
  @media(max-width:850px){.post-grid{grid-template-columns:1fr;gap:35px}.post-toc{position:static}.post-toc ol{columns:2;column-gap:25px}.post-toc li{break-inside:avoid}.post-header{margin-top:36px}.post-layout{padding-left:6%;padding-right:6%}}
  @media(max-width:500px){.post-header h1{font-size:36px}.post-description{font-size:16px}.post-toc ol{columns:1}.post-content h2{font-size:25px}.post-content{font-size:15px}.post-grid{padding-top:28px}.post-content th,.post-content td{padding:10px}.figure-dialog{padding:12px}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
