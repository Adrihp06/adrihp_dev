---
import BaseLayout from '../layouts/PortfolioLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
import featured from '../components/portfolio/projects.html?raw';
const travelRuter = projects.find(project => project.slug === 'travel-ruter');
---
<BaseLayout title="Projects · Adrián Hernández Padrón">
{travelRuter && <Fragment set:html={featured}/>}
</BaseLayout>
