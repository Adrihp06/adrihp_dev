---
import '../styles/portfolio.css';
import SocialMetadata from '../components/SocialMetadata.astro';
import footer from '../components/portfolio/footer.html?raw';
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; type?: 'website' | 'article'; }
const {image, imageAlt, type, title = 'Adrián Hernández Padrón', description = 'AI Engineer, ML Engineer and Data Scientist. Projects and notes from the work.'} = Astro.props;
const links = [['Home','/'],['Projects','/projects'],['Blog','/blog'],['Contact','/contact']];
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><title>{title}</title><SocialMetadata title={title} description={description} image={image} imageAlt={imageAlt} type={type}/><link rel="icon" href="/favicon.svg"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/></head>
<body>
<a class="skip" href="#main-content">Skip to content</a>
<nav class="nav" aria-label="Main navigation"><a class="brand" href="/">Adrián Hernández Padrón</a><div class="navlinks">{links.map(([label,href])=><a href={href} aria-current={(href==='/'?Astro.url.pathname==='/':Astro.url.pathname.startsWith(href))?'page':undefined}>{label}</a>)}</div></nav>
<div id="main-content"><slot/></div>
<div class="wrap portfolio-footer" set:html={footer}/>
<script>
import { mountOrbit } from '../lib/orbit-view.js';
import { mountPageMotion } from '../lib/page-motion.js';
import { mountPortfolio } from '../lib/portfolio-motion.js';
const preference=matchMedia('(prefers-reduced-motion: reduce)');
const canvas=document.querySelector<HTMLCanvasElement>('#dynamics-canvas');
if(canvas)mountOrbit(canvas,preference);
document.querySelectorAll<HTMLElement>('[data-page-motion]').forEach(root=>mountPageMotion(root,preference));
mountPortfolio(preference);
</script>
</body></html>
