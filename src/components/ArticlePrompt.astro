---
import { buildArticlePrompt } from '../lib/article-prompt';

interface Props {
  title: string;
  author: string;
  description: string;
  body: string;
}

const prompt = buildArticlePrompt(Astro.props);
---

<section class="article-prompt" aria-labelledby="article-prompt-title" data-article-prompt>
  <div class="prompt-intro">
    <div>
      <h2 id="article-prompt-title">Understand this article with your AI</h2>
      <p>Get a summary, clear explanations and examples. Copy the prompt and article, then paste them into your AI chat.</p>
    </div>
    <button class="prompt-copy" type="button" data-copy-prompt hidden>Copy prompt</button>
  </div>
  <p class="prompt-status" role="status" aria-atomic="true" data-prompt-status></p>
  <details class="prompt-preview">
    <summary>View prompt and article text</summary>
    <label for="article-prompt-text">You can also select and copy this text manually.</label>
    <textarea id="article-prompt-text" readonly spellcheck="false" rows="9" aria-label="Prompt and complete article text">{prompt}</textarea>
  </details>
</section>

<script>
  import { initializeArticlePrompt } from '../lib/article-prompt';
  initializeArticlePrompt();
</script>

<style>
  .article-prompt {
    margin-top: 30px;
    padding: 22px 24px;
    background: var(--surface);
    color: var(--ink);
    border-radius: 4px;
  }

  .prompt-intro {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.02em;
  }

  .prompt-intro p {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--muted);
  }

  .prompt-copy {
    flex-shrink: 0;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background: var(--accent);
    color: var(--accentink);
    font-size: 13px;
    font-weight: 600;
    transition: filter 180ms ease-out;
  }

  .prompt-copy:hover { filter: brightness(1.1); }
  .prompt-copy:active { filter: brightness(.95); }
  .prompt-copy:disabled { cursor: wait; }
  .prompt-copy:focus-visible, summary:focus-visible, textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .prompt-status {
    display: flex;
    align-items: center;
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.7;
    color: var(--accent);
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 180ms ease-out, transform 220ms cubic-bezier(.16, 1, .3, 1);
  }
  .article-prompt[data-prompt-ready] .prompt-status {
    min-block-size: calc(3.4em + 20px);
    margin-top: 10px;
    padding: 9px 12px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background: var(--bg);
  }
  .prompt-status:not(:empty) { opacity: 1; transform: translateY(0); }

  .prompt-preview { margin-top: 12px; }
  summary { width: fit-content; font-size: 12px; color: var(--accent); cursor: pointer; }
  summary:hover { text-decoration: underline; text-underline-offset: 4px; }
  label { display: block; margin: 14px 0 8px; font-size: 12px; color: var(--muted); }
  textarea {
    display: block;
    width: 100%;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--bg);
    color: var(--ink);
    caret-color: var(--accent);
    font-size: 13px;
    line-height: 1.7;
    resize: vertical;
  }
  textarea::selection { background: var(--accent); color: var(--accentink); }

  @media (max-width: 600px) {
    .article-prompt { padding: 20px; }
    .prompt-intro { flex-direction: column; align-items: flex-start; gap: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .prompt-copy, .prompt-status { transition: none; }
    .prompt-status { transform: none; }
  }
</style>
